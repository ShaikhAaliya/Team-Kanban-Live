<%- include('../partials/header') %>
<main class="container page"><a class="back" href="/projects/<%= project.id %>">← Back to board</a>
<div class="task-nav"><a class="btn" href="/projects/<%= project.id %>/search">Search</a><a class="btn" href="/projects/<%= project.id %>/calendar">Calendar</a></div>
<div class="detail-grid"><section class="panel"><div class="eyebrow"><%= project.name %></div><h1><%= task.title %></h1><p class="muted"><%= task.description || 'No description added.' %></p>
<div class="task-meta"><span class="pill"><%= task.status.replace('_',' ') %></span><span class="priority <%= task.priority %>"><%= task.priority %></span><span>Due: <%= task.due_date || 'Not set' %></span><span>Assigned: <%= task.assignee || 'Unassigned' %></span></div>
<h3>Update task</h3><form method="POST" action="/projects/<%= project.id %>/tasks/<%= task.id %>/update" class="form-grid"><input name="title" value="<%= task.title %>" required><textarea name="description"><%= task.description %></textarea><select name="priority"><% ['low','medium','high','urgent'].forEach(p=>{ %><option value="<%=p%>" <%=task.priority===p?'selected':''%>><%=p%></option><% }) %></select><select name="assigned_to"><option value="">Unassigned</option><% members.forEach(m=>{ %><option value="<%=m.id%>" <%=String(task.assigned_to)===String(m.id)?'selected':''%>><%=m.name%></option><% }) %></select><input type="date" name="due_date" value="<%= task.due_date || '' %>"><button class="btn" type="submit">Save changes</button></form>
<div class="card inset"><h3>Tags</h3><form method="post" action="/projects/<%= project.id %>/tasks/<%= task.id %>/tags" class="inline-form"><input name="tags" value="<%= taskTags.map(t=>t.name).join(', ') %>" placeholder="frontend, api, urgent"><button class="btn">Save tags</button></form><div class="tag-list"><% taskTags.forEach(t=>{ %><span class="tag">#<%= t.name %></span><% }) %></div></div>
<div class="card inset"><h3>Attachments</h3><form method="post" enctype="multipart/form-data" action="/projects/<%= project.id %>/tasks/<%= task.id %>/attachments" class="inline-form"><input type="file" name="file" required><button class="btn">Upload</button></form><ul class="attachment-list"><% attachments.forEach(a=>{ %><li><a href="/uploads/<%= a.stored_name %>" target="_blank"><%= a.original_name %></a><span><%= a.user_name %></span></li><% }) %></ul></div>
<h3>Comments</h3><form method="POST" action="/projects/<%= project.id %>/tasks/<%= task.id %>/comments"><textarea name="comment" placeholder="Write a comment..." required></textarea><button class="btn" type="submit">Add comment</button></form><div class="comments"><% comments.forEach(c=>{ %><div class="comment"><b><%=c.user_name%></b><small><%=c.created_at%></small><p><%=c.comment%></p></div><% }) %><% if(!comments.length){%><p class="muted">No comments yet.</p><%}%></div></section>
<aside class="panel"><h3>Activity history</h3><div class="activity-list"><% activities.forEach(a=>{ %><div class="activity"><b><%=a.user_name%></b> <%=a.action%><small><%=a.created_at%></small></div><% }) %></div></aside></div></main>
<%- include('../partials/footer') %>
