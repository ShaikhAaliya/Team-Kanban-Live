<%- include('partials/header') %><main class="container"><div class="page-head"><div><p class="eyebrow">WORKSPACE</p><h1>Project Dashboard</h1><p class="muted">Create projects and keep your team's work moving.</p></div><button class="primary" onclick="document.getElementById('newProject').showModal()">+ New Project</button></div><section class="stats"><div><b><%= projects.length %></b><span>Projects</span></div><div><b><%= projects.reduce((a,p)=>a+(p.task_count||0),0) %></b><span>Total Tasks</span></div><div><b><%= projects.reduce((a,p)=>a+(p.done_count||0),0) %></b><span>Completed</span></div></section><div class="project-grid"><% projects.forEach(p=>{ %><a class="project-card" href="/projects/<%= p.id %>"><div class="project-icon">✓</div><h3><%= p.name %></h3><p><%= p.description || 'No description' %></p><div class="project-meta"><span><%= p.task_count||0 %> tasks</span><span><%= p.done_count||0 %> done</span></div></a><% }) %><% if(!projects.length){ %><div class="empty">No projects yet. Create your first project.</div><% } %></div></main><dialog id="newProject"><form method="post" action="/projects"><button type="button" class="close" onclick="newProject.close()">×</button><h2>New Project</h2><label>Project name</label><input name="name" required placeholder="e.g. E-Commerce Website"><label>Description</label><textarea name="description" rows="4" placeholder="What is this project about?"></textarea><button class="primary full">Create Project</button></form></dialog><%- include('partials/footer') %>
