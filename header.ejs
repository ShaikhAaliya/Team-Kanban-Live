<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Team Kanban Live</title><link rel="stylesheet" href="/css/style.css"></head><body><header class="topbar"><a class="brand" href="/dashboard">Team <span>Kanban</span> Live</a><div class="user-area"><button class="notify" onclick="loadNotifications()">🔔 <span id="notifyCount">0</span></button><% if(currentUser){ %><% if(currentUser.role==='admin'){ %><a class="link-btn" href="/admin">Admin</a><% } %><span><%= currentUser.name %></span><form action="/logout" method="post"><button class="link-btn">Logout</button></form><% } %></div></header>
<div id="notificationPanel" class="notification-panel"></div><script>async function loadNotifications(){const r=await fetch('/api/notifications');const items=await r.json();const p=document.getElementById('notificationPanel');p.innerHTML=items.length?items.map(n=>`<div><b>${n.message}</b><small>${n.created_at}</small></div>`).join(''):'<div>No notifications</div>';p.classList.toggle('show');await fetch('/api/notifications/read',{method:'POST'});document.getElementById('notifyCount').textContent='0'} async function notificationCount(){const r=await fetch('/api/notifications');const items=await r.json();document.getElementById('notifyCount').textContent=items.filter(x=>!x.is_read).length} if(document.getElementById('notifyCount')) notificationCount();</script>