<%- include('../partials/header') %><main class="container wide"><div class="page-head"><div><a class="back" href="/dashboard">← Dashboard</a><h1><%= project.name %></h1><p class="muted"><%= project.description %></p></div><div class="board-actions"><a class="btn" href="/projects/<%= project.id %>/search">Search</a><a class="btn" href="/projects/<%= project.id %>/calendar">Calendar</a><button class="primary" onclick="document.getElementById('newTask').showModal()">+ Add Task</button></div></div><div class="board" id="board"><% const cols=[['todo','To Do'],['in_progress','In Progress'],['review','Review'],['done','Done']]; cols.forEach(c=>{ %><section class="column" data-status="<%= c[0] %>"><div class="column-title"><h3><%= c[1] %></h3><span><%= tasks.filter(t=>t.status===c[0]).length %></span></div><div class="dropzone"><% tasks.filter(t=>t.status===c[0]).forEach(t=>{ %><article class="task" draggable="true" data-id="<%= t.id %>" onclick="location.href='/projects/<%= project.id %>/tasks/<%= t.id %>'"><div class="task-top"><span class="priority <%= t.priority %>"><%= t.priority %></span></div><h4><%= t.title %></h4><% if(t.description){ %><p><%= t.description %></p><% } %><div class="task-foot"><span><%= t.assignee||'Unassigned' %></span><span><%= t.due_date||'' %></span></div></article><% }) %></div></section><% }) %></div><div class="below-grid"><section class="panel"><h3>Team members</h3><div class="member-list"><% members.forEach(m=>{ %><div class="member"><div class="avatar"><%= m.name.charAt(0).toUpperCase() %></div><div><b><%=m.name%></b><small><%=m.email%> · <%=m.role%></small></div></div><% }) %></div><% if(['owner','admin','lead'].includes(project.member_role)){ %><form class="inline-form" method="POST" action="/projects/<%=project.id%>/members"><input type="email" name="email" placeholder="Existing user's email" required><button class="btn" type="submit">Add member</button></form><% } %></section><section class="panel"><h3>Recent activity</h3><div class="activity-list"><% activities.forEach(a=>{ %><div class="activity"><b><%=a.user_name%></b> <%=a.action%><% if(a.task_title){ %> · <%=a.task_title%><% } %><small><%=a.created_at%></small></div><% }) %></div></section></div></main><dialog id="newTask"><form method="post" action="/projects/<%= project.id %>/tasks"><button type="button" class="close" onclick="newTask.close()">×</button><h2>Add Task</h2><label>Task title</label><input name="title" required placeholder="What needs to be done?"><label>Description</label><textarea name="description" rows="3"></textarea><div class="form-row"><div><label>Priority</label><select name="priority"><option>low</option><option selected>medium</option><option>high</option></select></div><div><label>Assign to</label><select name="assigned_to"><option value="">Unassigned</option><% members.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select></div></div><label>Tags (comma separated)</label><input name="tags" placeholder="frontend, urgent">
<label>Due date</label><input type="date" name="due_date"><button class="primary full">Create Task</button></form></dialog><script src="/socket.io/socket.io.js"></script><script>window.PROJECT_ID=<%= project.id %>;</script><script src="/js/kanban.js"></script><%- include('../partials/footer') %>
